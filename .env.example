# Process-environment template only. Do not copy this file to .workaholic.env;
# workaholic up creates that strict Workspace context file.
# Optional trusted profile configuration directory for tests and managed local
# runtimes. Leave empty to use the operating system's standard configuration
# directory. Example: /absolute/path/to/workaholic-config
# profiles.toml may define embedded profiles only.
WORKAHOLIC_CONFIG_DIR=
# Optional trusted profile selection. Example: local
# Leave empty to use context/config defaults.
WORKAHOLIC_PROFILE=
# Optional data directory for the built-in local profile when profiles.toml is
# absent. Example: /absolute/path/to/workaholic-data
# Leave empty to use the operating system's standard user data directory.
WORKAHOLIC_DATA_DIR=

# Process-environment template only. Do not copy this file to .workaholic.env;
# workaholic up creates that strict Workspace context file.
# Optional trusted profile configuration directory for tests and managed local
# runtimes. Leave empty to use the operating system's standard configuration
# directory. Example: /absolute/path/to/workaholic-config
# profiles.toml may define embedded profiles only. Remote URLs, credentials,
# Tokens, secret references, and executable paths are not supported.
WORKAHOLIC_CONFIG_DIR=
# Optional trusted process-level profile selection. Example: local
# Leave empty to use discovered context, config, or built-in defaults.
WORKAHOLIC_PROFILE=
# Optional data directory for the built-in local profile when profiles.toml is
# absent. Example: /absolute/path/to/workaholic-data
# Leave empty to use the operating system's standard user data directory.
WORKAHOLIC_DATA_DIR=
# Optional direct Agent bearer Token. Mutually exclusive with
# WORKAHOLIC_TOKEN_FILE. Empty means absent. Treat this as a trusted process
# secret and never copy it into .workaholic.env or profiles.toml.
WORKAHOLIC_TOKEN=
# Optional absolute mounted-secret path containing one Token and at most one
# final newline. Mutually exclusive with WORKAHOLIC_TOKEN.
WORKAHOLIC_TOKEN_FILE=
# Human credential backend: auto, keyring, or file. The default prefers an
# available operating-system keyring and uses the protected file backend only
# when no keyring backend exists. Operational keyring failures never downgrade.
WORKAHOLIC_CREDENTIAL_BACKEND=auto
